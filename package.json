{
  "name": "obsidian-decision-review",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Record the reasons behind a decision and review what happened later.",
  "author": "fineuralab",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "package": "npm run build && python3 scripts/package.py"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.11",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
